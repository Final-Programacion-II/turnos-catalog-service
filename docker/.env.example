# Variables del catálogo en Docker. Copiar como docker/.env y completar.
# El .env no se sube al repositorio.
#
# Los valores de la cátedra son los mismos que ya están en el .env del servicio.

# Contraseña de la base (se crea con este valor la primera vez)
CATALOG_DB_PASSWORD=

# Secreto de los JWT (base64), el mismo que usa el servicio de turnos
JWT_BASE64_SECRET=

# API de la cátedra y JWT técnico de la cuenta de integración
CATEDRA_BASE_URL=
CATEDRA_TOKEN=

# Redis de la cátedra
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Kafka de la cátedra
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CATALOG_TOPIC=
CATALOG_KAFKA_GROUP_ID=
