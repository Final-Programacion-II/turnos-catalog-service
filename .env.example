# Variables de entorno del servicio de catálogo.
# Copiar como .env y completar. El .env no se sube al repositorio.

# API REST de la cátedra
CATEDRA_BASE_URL=
CATEDRA_TOKEN=

# Redis de la cátedra (datos de la cuenta de integración)
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=

# Kafka de la cátedra
SPRING_KAFKA_BOOTSTRAP_SERVERS=
CATEDRA_KAFKA_CATALOG_TOPIC=
CATEDRA_KAFKA_GROUP_ID=
