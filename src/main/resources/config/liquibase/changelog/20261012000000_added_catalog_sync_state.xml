<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261012000000-1" author="facumangione">
        <createTable tableName="catalog_sync_state">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="catalog_version" type="bigint"/>
            <column name="last_synced_at" type="${datetimeType}"/>
        </createTable>
    </changeSet>

    <changeSet id="20261012000000-2" author="facumangione">
        <insert tableName="catalog_sync_state">
            <column name="id" valueNumeric="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>
